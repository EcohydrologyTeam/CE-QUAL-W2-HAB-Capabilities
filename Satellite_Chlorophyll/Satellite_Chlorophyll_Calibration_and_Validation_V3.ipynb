    "# Create comprehensive comparison plots\n",
    "def create_lake_comparison_plot(calibrated_data_dict, insitu_data, lake_name, save_name):\n",
    "    \"\"\"\n",
    "    Create time series plot comparing all sensors for one lake.\n",
    "    \"\"\"\n",
    "    fig, ax = plt.subplots(figsize=(15, 8))\n",
    "    \n",
    "    colors = {'sentinel': 'blue', 'modis_aqua': 'green', 'modis_terra': 'red'}\n",
    "    markers = {'sentinel': 'o', 'modis_aqua': 's', 'modis_terra': '^'}\n",
    "    \n",
    "    for dataset_name, df in calibrated_data_dict.items():\n",
    "        if len(df) > 0 and 'calibrated_chl' in df.columns:\n",
    "            # Extract sensor type from dataset name\n",
    "            if 'sentinel' in dataset_name:\n",
    "                sensor_key = 'sentinel'\n",
    "                label = 'Sentinel-2'\n",
    "            elif 'modis_aqua' in dataset_name:\n",
    "                sensor_key = 'modis_aqua'\n",
    "                label = 'MODIS-Aqua'\n",
    "            elif 'modis_terra' in dataset_name:\n",
    "                sensor_key = 'modis_terra'\n",
    "                label = 'MODIS-Terra'\n",
    "            else:\n",
    "                sensor_key = 'other'\n",
    "                label = dataset_name\n",
    "            \n",
    "            color = colors.get(sensor_key, 'gray')\n",
    "            marker = markers.get(sensor_key, 'o')\n",
    "            \n",
    "            ax.scatter(df['date'], df['calibrated_chl'], \n",
    "                      color=color, alpha=0.6, s=15, marker=marker, label=label)\n",
    "    \n",
    "    # Add in situ data if provided\n",
    "    if insitu_data is not None and len(insitu_data) > 0:\n",
    "        ax.scatter(insitu_data['date'], insitu_data['chlorophyll_ugL'],\n",
    "                  color='black', s=30, marker='o', alpha=0.8, \n",
    "                  label='In Situ', zorder=10)\n",
    "    \n",
    "    ax.set_xlabel('Date', fontsize=12)\n",
    "    ax.set_ylabel('Chlorophyll-a (µg/L)', fontsize=12)\n",
    "    ax.set_title(f'{lake_name} - Calibrated Satellite Chlorophyll Time Series (V3)', fontsize=14)\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    ax.legend(loc='upper left')\n",
    "    ax.set_ylim(bottom=0)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    \n",
    "    # Save plot\n",
    "    plot_path = OUTPUT_DIR / f'{save_name}.png'\n",
    "    fig.savefig(plot_path, dpi=300, bbox_inches='tight')\n",
    "    print(f\"Time series plot saved: {plot_path}\")\n",
    "    \n",
    "    return fig\n",
    "\n",
    "# Upper Klamath Lake comparison\n",
    "ukl_cal = {k: v for k, v in calibrated_data.items() if 'ukl' in k}\n",
    "if ukl_cal:\n",
    "    fig_ukl = create_lake_comparison_plot(\n",
    "        ukl_cal, ukl_insitu,\n",
    "        'Upper Klamath Lake',\n",
    "        'UKL_comparison_v3'\n",
    "    )\n",
    "    plt.show()\n",
    "\n",
    "# Detroit Lake comparison\n",
    "detroit_cal = {k: v for k, v in calibrated_data.items() if 'detroit' in k}\n",
    "if detroit_cal:\n",
    "    fig_detroit = create_lake_comparison_plot(\n",
    "        detroit_cal, None,\n",
    "        'Detroit Lake',\n",
    "        'Detroit_comparison_v3'\n",
    "    )\n",
    "    plt.show()\n",
    "\n",
    "# Side-by-side comparison\n",
    "if ukl_cal and detroit_cal:\n",
    "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(15, 12), sharex=True)\n",
    "    \n",
    "    colors = {'sentinel': 'blue', 'modis_aqua': 'green', 'modis_terra': 'red'}\n",
    "    \n",
    "    # UKL subplot\n",
    "    for dataset_name, df in ukl_cal.items():\n",
    "        if len(df) > 0 and 'calibrated_chl' in df.columns:\n",
    "            sensor_key = dataset_name.split('_')[1] + ('_' + dataset_name.split('_')[2] if 'modis' in dataset_name else '')\n",
    "            color = colors.get(sensor_key, 'gray')\n",
    "            label = sensor_key.replace('_', '-').title()\n",
    "            \n",
    "            ax1.scatter(df['date'], df['calibrated_chl'], \n",
    "                       color=color, alpha=0.5, s=15, label=label)\n",
    "    \n",
    "    if len(ukl_insitu) > 0:\n",
    "        ax1.scatter(ukl_insitu['date'], ukl_insitu['chlorophyll_ugL'],\n",
    "                   color='black', s=30, alpha=0.8, label='In Situ')\n",
    "    \n",
    "    ax1.set_ylabel('Chlorophyll-a (µg/L)')\n",
    "    ax1.set_title('Upper Klamath Lake')\n",
    "    ax1.grid(True, alpha=0.3)\n",
    "    ax1.legend()\n",
    "    ax1.set_ylim(bottom=0)\n",
    "    \n",
    "    # Detroit subplot\n",
    "    for dataset_name, df in detroit_cal.items():\n",
    "        if len(df) > 0 and 'calibrated_chl' in df.columns:\n",
    "            sensor_key = dataset_name.split('_')[1] + ('_' + dataset_name.split('_')[2] if 'modis' in dataset_name else '')\n",
    "            color = colors.get(sensor_key, 'gray')\n",
    "            label = sensor_key.replace('_', '-').title()\n",
    "            \n",
    "            ax2.scatter(df['date'], df['calibrated_chl'], \n",
    "                       color=color, alpha=0.5, s=15, label=label)\n",
    "    \n",
    "    ax2.set_xlabel('Date')\n",
    "    ax2.set_ylabel('Chlorophyll-a (µg/L)')\n",
    "    ax2.set_title('Detroit Lake')\n",
    "    ax2.grid(True, alpha=0.3)\n",
    "    ax2.legend()\n",
    "    ax2.set_ylim(bottom=0)\n",
    "    \n",
    "    plt.suptitle('Satellite Chlorophyll Comparison - Both Lakes (V3)', fontsize=16)\n",
    "    plt.tight_layout()\n",
    "    \n",
    "    comparison_path = OUTPUT_DIR / 'both_lakes_comparison_v3.png'\n",
    "    fig.savefig(comparison_path, dpi=300, bbox_inches='tight')\n",
    "    print(f\"\\nCombined comparison plot saved: {comparison_path}\")\n",
    "    \n",
    "    plt.show()"
   ]
