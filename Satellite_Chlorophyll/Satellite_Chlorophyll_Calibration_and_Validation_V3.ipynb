    "# Configuration\n",
    "MATCH_TOLERANCE_DAYS = 5  # Maximum days between satellite and in situ observations\n",
    "MIN_CHLOROPHYLL = 0.5     # Minimum valid chlorophyll value (µg/L)\n",
    "MAX_CHLOROPHYLL = 500     # Maximum valid chlorophyll value (µg/L)\n",
    "MIN_NDCI = -0.8          # Minimum valid NDCI value\n",
    "MAX_NDCI = 0.8           # Maximum valid NDCI value\n",
    "MIN_LOG_RATIO = -1.0     # Minimum valid log10(green/red)\n",
    "MAX_LOG_RATIO = 1.0      # Maximum valid log10(green/red)\n",
    "\n",
    "OUTPUT_DIR = Path('calibration_results_v3')\n",
    "OUTPUT_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "# Data file paths (V3 MODIS format)\n",
    "DATA_PATHS = {\n",
    "    # Upper Klamath Lake (Calibration site)\n",
    "    'ukl_insitu': 'Data/Upper_Klamath_Lake/',\n",
    "    'ukl_sentinel': 'Klamath_S2_NDCI_500m.csv',\n",
    "    'ukl_modis_aqua': 'Klamath_MODIS_Aqua_500m_ROI.csv',    # V3 format\n",
    "    'ukl_modis_terra': 'Klamath_MODIS_Terra_500m_ROI.csv',  # V3 format\n",
    "    \n",
    "    # Detroit Lake (Application site)\n",
    "    'detroit_sentinel': 'Detroit_S2_NDCI_500m.csv',\n",
    "    'detroit_modis_aqua': 'Detroit_MODIS_Aqua_500m_ROI.csv',    # V3 format\n",
    "    'detroit_modis_terra': 'Detroit_MODIS_Terra_500m_ROI.csv'   # V3 format\n",
    "}\n",
    "\n",
    "print(f\"Output directory: {OUTPUT_DIR}\")\n",
    "print(f\"Match tolerance: ±{MATCH_TOLERANCE_DAYS} days\")\n",
    "print(f\"Valid chlorophyll range: {MIN_CHLOROPHYLL} - {MAX_CHLOROPHYLL} µg/L\")\n",
    "print(f\"Valid NDCI range: {MIN_NDCI} - {MAX_NDCI}\")\n",
    "print(f\"Valid log_ratio range: {MIN_LOG_RATIO} - {MAX_LOG_RATIO}\")"
   ]
