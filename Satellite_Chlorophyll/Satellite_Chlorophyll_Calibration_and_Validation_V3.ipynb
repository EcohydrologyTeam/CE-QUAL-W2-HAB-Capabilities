    "def apply_modis_calibration(modis_df, calibration_model):\n",
    "    \"\"\"\n",
    "    Apply MODIS calibration: log10(Chl) = a * log_ratio + b\n",
    "    \"\"\"\n",
    "    if not calibration_model or not calibration_model['success']:\n",
    "        return modis_df.copy()\n",
    "    \n",
    "    df = modis_df.copy()\n",
    "    \n",
    "    # Filter to valid log_ratio values\n",
    "    df = df[(df['value'] >= MIN_LOG_RATIO) & \n",
    "           (df['value'] <= MAX_LOG_RATIO) & \n",
    "           df['value'].notna()].copy()\n",
    "    \n",
    "    if len(df) == 0:\n",
    "        return df\n",
    "    \n",
    "    # Apply OCx calibration\n",
    "    log_chl = calibration_model['a'] * df['value'] + calibration_model['b']\n",
    "    df['calibrated_chl'] = 10 ** log_chl\n",
    "    \n",
    "    # Ensure reasonable range\n",
    "    df['calibrated_chl'] = np.clip(df['calibrated_chl'], MIN_CHLOROPHYLL, MAX_CHLOROPHYLL)\n",
    "    \n",
    "    return df\n",
    "\n",
    "def apply_sentinel_calibration(sentinel_df, calibration_model):\n",
    "    \"\"\"\n",
    "    Apply Sentinel-2 calibration directly to NDCI values.\n",
    "    \"\"\"\n",
    "    if not calibration_model or not calibration_model['success']:\n",
    "        return sentinel_df.copy()\n",
    "    \n",
    "    df = sentinel_df.copy()\n",
    "    \n",
    "    # Filter to valid NDCI values\n",
    "    df = df[(df['value'] >= MIN_NDCI) & \n",
    "           (df['value'] <= MAX_NDCI) & \n",
    "           df['value'].notna()].copy()\n",
    "    \n",
    "    if len(df) == 0:\n",
    "        return df\n",
    "    \n",
    "    # Apply calibration using stored sklearn model\n",
    "    if 'sklearn_model' in calibration_model:\n",
    "        df['calibrated_chl'] = calibration_model['sklearn_model'].predict(df['value'].values.reshape(-1, 1))\n",
    "    else:\n",
    "        # Fallback: manual calculation\n",
    "        if calibration_model['model_type'] == 'linear':\n",
    "            a, b = calibration_model['params']\n",
    "            df['calibrated_chl'] = a * df['value'] + b\n",
    "        elif calibration_model['model_type'] == 'polynomial':\n",
