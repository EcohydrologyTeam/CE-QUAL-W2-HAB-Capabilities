   "source": [
    "## Calibration Model Development"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define calibration functions for different sensor types\n",
    "def fit_modis_calibration(log_ratio, insitu_chl, sensor_name):\n",
    "    \"\"\"\n",
    "    Fit MODIS calibration using OCx approach: log10(Chl) = a * log10(ratio) + b\n",
    "    Input: log_ratio = log10(green/red), insitu_chl in µg/L\n",
    "    \"\"\"\n",
    "    if len(log_ratio) < 3:\n",
    "        return None\n",
    "    \n",
    "    # Convert chlorophyll to log space\n",
    "    log_chl = np.log10(insitu_chl)\n",
    "    \n",
    "    # Remove any invalid values\n",
    "    valid_mask = np.isfinite(log_ratio) & np.isfinite(log_chl)\n",
    "    log_ratio = log_ratio[valid_mask]\n",
    "    log_chl = log_chl[valid_mask]\n",
    "    \n",
    "    if len(log_ratio) < 3:\n",
    "        return None\n",
    "    \n",
    "    try:\n",
    "        # Fit log10(Chl) = a * log_ratio + b using robust regression\n",
    "        model = HuberRegressor()\n",
    "        model.fit(log_ratio.reshape(-1, 1), log_chl)\n",
    "        \n",
    "        # Predictions in log space\n",
    "        log_chl_pred = model.predict(log_ratio.reshape(-1, 1))\n",
    "        \n",
    "        # Convert back to linear space for evaluation\n",
    "        chl_pred = 10 ** log_chl_pred\n",
    "        \n",
    "        results = {\n",
    "            'sensor': sensor_name,\n",
    "            'model_type': 'OCx_style',\n",
    "            'n_points': len(log_ratio),\n",
    "            'a': model.coef_[0],  # Slope in log space\n",
    "            'b': model.intercept_,  # Intercept in log space\n",
    "            'equation': f\"log10(Chl) = {model.coef_[0]:.3f} * log_ratio + {model.intercept_:.3f}\",\n",
    "            'r2_log': r2_score(log_chl, log_chl_pred),  # R² in log space\n",
    "            'r2_linear': r2_score(insitu_chl, chl_pred),  # R² in linear space\n",
    "            'rmse': np.sqrt(mean_squared_error(insitu_chl, chl_pred)),\n",
    "            'mae': mean_absolute_error(insitu_chl, chl_pred),\n",
    "            'bias': np.mean(chl_pred - insitu_chl),\n",
    "            'mape': np.mean(np.abs((insitu_chl - chl_pred) / insitu_chl)) * 100,\n",
    "            'success': True\n",
    "        }\n",
    "        \n",
    "        return results\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"MODIS calibration failed for {sensor_name}: {e}\")\n",
    "        return None\n",
    "\n",
    "def fit_sentinel_calibration(ndci, insitu_chl, sensor_name):\n",
    "    \"\"\"\n",
    "    Fit Sentinel-2 NDCI calibration using direct approach.\n",
    "    Tests linear and polynomial models.\n",
    "    \"\"\"\n",
    "    if len(ndci) < 3:\n",
    "        return None\n",
    "    \n",
    "    # Remove invalid values\n",
    "    valid_mask = np.isfinite(ndci) & np.isfinite(insitu_chl)\n",
    "    ndci = ndci[valid_mask]\n",
    "    insitu_chl = insitu_chl[valid_mask]\n",
    "    \n",
    "    if len(ndci) < 3:\n",
    "        return None\n",
    "    \n",
    "    models = {}\n",
    "    \n",
    "    try:\n",
    "        # Linear model: Chl = a * NDCI + b\n",
    "        linear_model = HuberRegressor()\n",
    "        linear_model.fit(ndci.reshape(-1, 1), insitu_chl)\n",
    "        linear_pred = linear_model.predict(ndci.reshape(-1, 1))\n",
    "        \n",
    "        models['linear'] = {\n",
    "            'model': linear_model,\n",
    "            'params': [linear_model.coef_[0], linear_model.intercept_],\n",
    "            'equation': f\"Chl = {linear_model.coef_[0]:.3f} * NDCI + {linear_model.intercept_:.3f}\",\n",
    "            'r2': r2_score(insitu_chl, linear_pred),\n",
    "            'rmse': np.sqrt(mean_squared_error(insitu_chl, linear_pred)),\n",
    "            'predictions': linear_pred\n",
    "        }\n",
    "        \n",
    "        # Polynomial model: Chl = a * NDCI² + b * NDCI + c\n",
    "        poly_model = Pipeline([\n",
    "            ('poly', PolynomialFeatures(degree=2)),\n",
    "            ('linear', HuberRegressor())\n",
    "        ])\n",
    "        poly_model.fit(ndci.reshape(-1, 1), insitu_chl)\n",
    "        poly_pred = poly_model.predict(ndci.reshape(-1, 1))\n",
    "        \n",
    "        # Get polynomial coefficients\n",
    "        poly_coeffs = poly_model.named_steps['linear'].coef_\n",
    "        poly_intercept = poly_model.named_steps['linear'].intercept_\n",
    "        \n",
    "        models['polynomial'] = {\n",
    "            'model': poly_model,\n",
    "            'params': [poly_coeffs[2], poly_coeffs[1], poly_intercept],  # [a, b, c] for ax²+bx+c\n",
    "            'equation': f\"Chl = {poly_coeffs[2]:.3f} * NDCI² + {poly_coeffs[1]:.3f} * NDCI + {poly_intercept:.3f}\",\n",
    "            'r2': r2_score(insitu_chl, poly_pred),\n",
    "            'rmse': np.sqrt(mean_squared_error(insitu_chl, poly_pred)),\n",
    "            'predictions': poly_pred\n",
    "        }\n",
    "        \n",
    "        # Select best model\n",
    "        best_model_name = max(models.keys(), key=lambda k: models[k]['r2'])\n",
    "        best_model = models[best_model_name]\n",
    "        \n",
    "        results = {\n",
    "            'sensor': sensor_name,\n",
    "            'model_type': best_model_name,\n",
    "            'n_points': len(ndci),\n",
    "            'params': best_model['params'],\n",
    "            'equation': best_model['equation'],\n",
    "            'r2': best_model['r2'],\n",
    "            'rmse': best_model['rmse'],\n",
    "            'mae': mean_absolute_error(insitu_chl, best_model['predictions']),\n",
    "            'bias': np.mean(best_model['predictions'] - insitu_chl),\n",
    "            'mape': np.mean(np.abs((insitu_chl - best_model['predictions']) / insitu_chl)) * 100,\n",
    "            'success': True,\n",
    "            'sklearn_model': best_model['model']  # Store for later use\n",
    "        }\n",
    "        \n",
    "        return results\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"Sentinel calibration failed for {sensor_name}: {e}\")\n",
    "        return None\n",
    "\n",
    "# Fit calibration models for each sensor\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"Developing calibration models...\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "calibration_models = {}\n",
    "\n",
    "for sensor_key, match_df in matches.items():\n",
    "    if len(match_df) == 0:\n",
    "        continue\n",
    "    \n",
    "    print(f\"\\n{sensor_key.upper()} Calibration:\")\n",
    "    print(f\"Number of matched points: {len(match_df)}\")\n",
    "    \n",
    "    if len(match_df) >= 3:\n",
    "        if 'sentinel' in sensor_key:\n",
    "            # Direct NDCI calibration\n",
    "            ndci_values = match_df['satellite_value'].values\n",
    "            insitu_values = match_df['insitu_chl'].values\n",
    "            model = fit_sentinel_calibration(ndci_values, insitu_values, sensor_key)\n",
    "            \n",
    "        elif 'modis' in sensor_key:\n",
    "            # OCx-style log_ratio calibration\n",
    "            log_ratio_values = match_df['satellite_value'].values\n",
    "            insitu_values = match_df['insitu_chl'].values\n",
    "            model = fit_modis_calibration(log_ratio_values, insitu_values, sensor_key)\n",
    "        \n",
    "        if model and model['success']:\n",
    "            calibration_models[sensor_key] = model\n",
    "            print(f\"  Model: {model['model_type']}\")\n",
    "            print(f\"  R²: {model['r2']:.3f}\")\n",
    "            print(f\"  RMSE: {model['rmse']:.2f} µg/L\")\n",
    "            print(f\"  MAE: {model['mae']:.2f} µg/L\")\n",
    "            print(f\"  Equation: {model['equation']}\")\n",
    "    else:\n",
    "        print(f\"  Insufficient data points for calibration (need ≥3, have {len(match_df)})\")\n",
    "\n",
    "print(f\"\\n\" + \"=\"*60)\n",
    "print(f\"Calibration complete. Developed models for {len(calibration_models)} sensors.\")\n",
    "print(\"=\"*60)"
   ]
